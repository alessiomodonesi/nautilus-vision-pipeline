[Unit]
Description=Nautilus Vision Pipeline Auto-Start
After=network.target multi-user.target

[Service]
Type=simple
User=nautilus
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="CYCLONEDDS_URI=file:///home/nautilus/nautilus-vision-pipeline/deploy/cyclonedds.xml"
Environment="ROS_DOMAIN_ID=42"
ExecStart=/bin/bash /usr/local/bin/start_pipeline.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target