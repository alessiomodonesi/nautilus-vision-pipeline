[Unit]
Description=Lock Pi Camera v3 photometric parameters
After=nautilus-vision.service
PartOf=nautilus-vision.service

[Service]
Type=oneshot
User=nautilus
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash /home/nautilus/nautilus-vision-pipeline/deploy/lock_cameras.sh
RemainAfterExit=yes

[Install]
WantedBy=nautilus-vision.service