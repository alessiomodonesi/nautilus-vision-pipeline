[Unit]
Description=Lock Pi Camera v3 photometric parameters
After=nautilus-vision.service
PartOf=nautilus-vision.service

[Service]
Type=oneshot
User=nautilus
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/nautilus/nautilus-vision-pipeline/ros2_ws/install/setup.bash && exec /usr/bin/python3 /home/nautilus/nautilus-vision-pipeline/deploy/lock_cameras.py'
RemainAfterExit=yes

[Install]
WantedBy=nautilus-vision.service