<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nautilus_camera</name>
  <version>0.0.1</version>
  <description>Stereo camera node for the Nautilus vehicle. Runs on the Raspberry Pi hosts.</description>
  <!-- TODO: set a real maintainer before the first release -->
  <maintainer email="TODO@example.com">Nautilus Software Team</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/nautilus-unipd/Nautilus</url>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>camera_info_manager</depend>
  <depend>image_transport</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
